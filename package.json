{
  "name": "jarvis-mark-5",
  "version": "1.0.0",
  "private": true,
  "description": "JARVIS Mark 5 \u2014 a self-hosted AI workspace running on free, fast inference.",
  "license": "GPL-3.0",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/unit.test.mts && tsx test/workspace.test.mts",
    "test:e2e": "node test/e2e.mjs",
    "mock": "node test/mock-provider.mjs",
    "setup:voice": "node scripts/setup-voice.mjs",
    "postinstall": "node scripts/setup-voice.mjs",
    "test:voice": "node test/e2e-voice.mjs",
    "dev:https": "next dev --experimental-https -H 127.0.0.1",
    "dev:lan": "JARVIS_OPEN_NETWORK=1 next dev -H 0.0.0.0",
    "start:lan": "JARVIS_OPEN_NETWORK=1 next start -H 0.0.0.0"
  },
  "dependencies": {
    "@ricky0123/vad-web": "^0.0.31",
    "highlight.js": "11.12.0",
    "kokoro-js": "^1.2.1",
    "lucide-react": "1.44.0",
    "next": "16.3.4",
    "onnxruntime-web": "^1.29.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
