# ---------------------------------------------------------------------------
# JARVIS Mark 1 — copy this file to `.env.local` and fill in at least one key.
# `.env.local` is gitignored. Never commit real keys.
# ---------------------------------------------------------------------------

# Groq — https://console.groq.com/keys
# Free, no credit card. Very fast. ~30 requests/min, and 6,000 tokens per
# MINUTE — which is the limit you actually hit, since one tool-using turn is
# several requests each carrying the whole conversation. JARVIS caps a request
# at 3,500 tokens in + 2,048 out to stay inside it; raise these if your account
# has a higher limit.
GROQ_API_KEY=
# JARVIS_GROQ_REQUEST_TOKENS=3500
# JARVIS_GROQ_MAX_TOKENS=2048

# Cerebras — https://cloud.cerebras.ai
# Free, no credit card. 1M tokens/day. Fastest tokens/sec, but 8K context on free.
CEREBRAS_API_KEY=

# GitHub Models — https://github.com/settings/personal-access-tokens
# Free with any GitHub account (13+). Slower: ~10 req/min, 8K in / 4K out.
# Create a fine-grained token with the "Models" permission enabled.
GITHUB_MODELS_TOKEN=

# ---------------------------------------------------------------------------
# Web search. Backends are tried best-first; DuckDuckGo needs nothing at all,
# so search works even with this whole section empty.
# ---------------------------------------------------------------------------

# Tavily — https://app.tavily.com — 1,000 searches/month free, no card.
# Best quality: returns extracted page content rather than raw links.
TAVILY_API_KEY=

# SearXNG — no key, just a URL. Most PUBLIC instances disable the JSON API,
# so this usually means running your own:
#   docker run -d -p 8080:8080 searxng/searxng
# then enable `json` under `search.formats` in its settings.yml.
SEARXNG_URL=

# Force one backend instead of best-available: tavily | searxng | duckduckgo
# JARVIS_SEARCH_BACKEND=

# ---------------------------------------------------------------------------
# Voice. Speech-to-text uses your existing Groq key (free: 2,000/day).
# The wake word runs locally and needs no key at all.
# ---------------------------------------------------------------------------

# Override the transcription / speech models if you want to.
# JARVIS_WHISPER_MODEL=whisper-large-v3
# JARVIS_TTS_MODEL=playai-tts
# JARVIS_TTS_VOICE=Fritz-PlayAI

# ---------------------------------------------------------------------------
# Reaching JARVIS from your phone or another machine.
#
# `npm run dev` listens on localhost ONLY. That is the security boundary:
# nothing off this machine can connect, so no password is needed locally.
#
# To reach it from elsewhere, put a tunnel in front — which gives you a real
# HTTPS URL, so voice works too:
#     cloudflared tunnel --url http://localhost:3000
#
# A tunnel rewrites the Host header, so JARVIS then REQUIRES this password.
# Without one set it refuses to serve rather than defaulting to open.
# ---------------------------------------------------------------------------
JARVIS_PASSWORD=

# ---------------------------------------------------------------------------
# Letting JARVIS use your computer. Off unless set to exactly "1".
#
# Enables list_files / read_file / write_file / run_command, confined to the
# workspace directory. Every write and every command needs your approval, and
# commands run with all API keys stripped from their environment.
#
# Think before combining this with a tunnel: anyone with the password can then
# run commands on this machine.
# ---------------------------------------------------------------------------
# JARVIS_ALLOW_COMPUTER=1
# JARVIS_WORKSPACE=./workspace

# ---------------------------------------------------------------------------
# Your own model, on your own hardware.
#
# The free tiers are fast but metered. A local server is the opposite — slow,
# and it never runs out — which makes it the right backstop rather than the
# right default. JARVIS tries the cloud first and falls back to this when a
# rate limit hits, so you stop seeing hard failures.
#
# On the machine with the GPU or the fast CPU:
#     curl -fsSL https://ollama.com/install.sh | sh
#     ollama pull qwen3:4b          # ~2.5GB. See the README for sizing.
#     OLLAMA_HOST=0.0.0.0 OLLAMA_KEEP_ALIVE=-1 ollama serve
#
# OLLAMA_HOST=0.0.0.0 lets another machine (a Pi) reach it; KEEP_ALIVE=-1 stops
# the model being unloaded after five idle minutes, which otherwise costs
# 10-20 seconds on the first question after a gap.
#
# Then point JARVIS at it. No API key — there is nobody to authenticate.
# ---------------------------------------------------------------------------
# JARVIS_LOCAL_BASE_URL=http://192.168.1.50:11434/v1

# Pin the model, or JARVIS picks whichever sorts first alphabetically — a coin
# toss on a machine with several pulled.
# JARVIS_LOCAL_MODEL=qwen3:4b

# Must not exceed the num_ctx the model was loaded with, or Ollama silently
# truncates the conversation instead of erroring.
# JARVIS_LOCAL_CONTEXT=3500

# Which provider to use by default: groq | cerebras | github | local
JARVIS_DEFAULT_PROVIDER=groq

# Storage driver: fs (JSON files in ./data) | memory (ephemeral, for serverless)
# Leave unset to auto-detect: `fs` locally, `memory` on Vercel.
# JARVIS_STORAGE=fs
