# ---------------------------------------------------------------------------
# JARVIS Mark 1 — copy this file to `.env.local` and fill in at least one key.
# `.env.local` is gitignored. Never commit real keys.
# ---------------------------------------------------------------------------

# Groq — https://console.groq.com/keys
# Free, no credit card. ~30 requests/min, 14,400/day. Very fast, large context.
GROQ_API_KEY=

# Cerebras — https://cloud.cerebras.ai
# Free, no credit card. 1M tokens/day. Fastest tokens/sec, but 8K context on free.
CEREBRAS_API_KEY=

# GitHub Models — https://github.com/settings/personal-access-tokens
# Free with any GitHub account (13+). Slower: ~10 req/min, 8K in / 4K out.
# Create a fine-grained token with the "Models" permission enabled.
GITHUB_MODELS_TOKEN=

# Which provider to use by default: groq | cerebras | github
JARVIS_DEFAULT_PROVIDER=groq

# Storage driver: fs (JSON files in ./data) | memory (ephemeral, for serverless)
# Leave unset to auto-detect: `fs` locally, `memory` on Vercel.
# JARVIS_STORAGE=fs
