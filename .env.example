# ---------------------------------------------------------------------------
# JARVIS Mark 1 — copy this file to `.env.local` and fill in at least one key.
# `.env.local` is gitignored. Never commit real keys.
# ---------------------------------------------------------------------------

# Groq — https://console.groq.com/keys
# Free, no credit card. Very fast. ~30 requests/min, and 6,000 tokens per
# MINUTE — which is the limit you actually hit, since one tool-using turn is
# several requests each carrying the whole conversation. JARVIS caps a request
# at 3,500 tokens in + 2,048 out to stay inside it; raise these if your account
# has a higher limit.
GROQ_API_KEY=
# JARVIS_GROQ_REQUEST_TOKENS=3500
# JARVIS_GROQ_MAX_TOKENS=2048

# Cerebras — https://cloud.cerebras.ai
# Free, no credit card. 1M tokens/day. Fastest tokens/sec, but 8K context on free.
CEREBRAS_API_KEY=

# Gemini (Google AI Studio) — https://aistudio.google.com/apikey
# Free, no credit card. 250,000 tokens/MINUTE — roughly 40x Groq's budget, so
# this is the one to add if you keep running out mid-conversation.
# Note: Google's free tier may use your conversations to improve its products.
GEMINI_API_KEY=

# Mistral — https://console.mistral.ai/api-keys
# Free, no credit card. Roughly 1B tokens/month. Exact rate limits are no
# longer published, so JARVIS ships a conservative per-request budget.
MISTRAL_API_KEY=

# NanoGPT — https://nano-gpt.com/
# $8/mo, the cheapest way off the free tiers and the first paid slot tried.
# Covers 200+ open models — every DeepSeek, Qwen and Kimi K2, plus uncensored
# and roleplay fine-tunes — and 100 images a day.
#
# Limits are 60 requests/minute (10 per 10s in burst) and 60M input tokens a
# week. Both are spent by how OFTEN you ask, not by how long you have been
# talking, which is what makes them unlike Groq's. If you somehow meet the
# weekly cap, lower this rather than paying more:
# JARVIS_NANOGPT_REQUEST_TOKENS=12000
NANOGPT_API_KEY=
# JARVIS_NANOGPT_CONTEXT=32000

# Featherless — https://featherless.ai/
# $25/mo, and only worth it for one reason: roughly 22,000 models, the entire
# Hugging Face open-weight catalogue behind one key, every size, 32K context.
# If NanoGPT above already has what you want, it is three times the price for
# models you will not use.
# (The $50 "Developer" plan is NOT a bigger version of this — it is $50 of
# credits billed per token, which is the metering these slots exist to avoid.)
# The picker lists 400 of them; type any other id into its filter box and
# choose "use it anyway".
FEATHERLESS_API_KEY=
# JARVIS_FEATHERLESS_CONTEXT=32000

# Arli AI — https://www.arliai.com/
# Paid, flat monthly rate. Unlimited tokens AND unlimited requests, which is
# the point: it is the one provider here that never rate-limits. Sits last in
# the fallback chain so the free tiers answer normal use and this catches what
# they cannot — you only touch what you pay for when you would otherwise have
# been stuck.
#   $10/mo — models up to 31B, 16K context (what JARVIS assumes)
#   $15/mo — models up to 355B, 32K context: set JARVIS_ARLI_CONTEXT=32000
ARLI_API_KEY=
# JARVIS_ARLI_CONTEXT=16000

# Awan LLM — https://awanllm.com/
# Paid, from ~$5/mo. Unlimited tokens, and its daily request caps (30-80k) are
# far beyond anything personal use reaches — rate limits are genuinely not the
# constraint here. The catalogue is the thing to know: Llama 3.1 8B and 70B
# and older, so check a model with the picker's "Can this model use tools?"
# before relying on it for the projector. 8B is weak at tool calling; 70B is
# acceptable.
AWAN_API_KEY=
# JARVIS_AWAN_CONTEXT=16000

# OpenRouter — https://openrouter.ai/keys
# 50 requests/day free, 1,000 after a one-off $10 credit. One key, hundreds of
# models. A tool-using turn is up to 5 requests, so free is ~10 turns a day.
OPENROUTER_API_KEY=

# GitHub Models was retired by GitHub on 30 July 2026 and has been removed.
# It was the only mainstream 13+ option; the remaining age-gate-free path is
# running the model yourself — see the self-hosted section below.

# ---------------------------------------------------------------------------
# Web search. Backends are tried best-first; DuckDuckGo needs nothing at all,
# so search works even with this whole section empty.
# ---------------------------------------------------------------------------

# Tavily — https://app.tavily.com — 1,000 searches/month free, no card.
# Best quality: returns extracted page content rather than raw links.
TAVILY_API_KEY=

# SearXNG — no key, just a URL. Most PUBLIC instances disable the JSON API,
# so this usually means running your own:
#   docker run -d -p 8080:8080 searxng/searxng
# then enable `json` under `search.formats` in its settings.yml.
SEARXNG_URL=

# Force one backend instead of best-available: tavily | searxng | duckduckgo
# JARVIS_SEARCH_BACKEND=

# ---------------------------------------------------------------------------
# Voice.
#
# Speaking is entirely local: Kokoro (Apache-2.0, 82M params) is fetched once
# by `npm install` into public/models/kokoro and served from this app. No key,
# no cloud, works offline. If it didn't download, JARVIS says so and stays
# quiet rather than falling back to the browser's built-in voice — which on
# Chrome is a Google voice. Re-run `npm run setup:voice` to fix it.
#
# The wake word and speech detection are local too. Speech-to-TEXT still uses
# your Groq key (free: 2,000/day).
# ---------------------------------------------------------------------------

# JARVIS_WHISPER_MODEL=whisper-large-v3

# The optional Groq TTS engine, selectable in Settings if you want a cloud
# voice. Note Groq RETIRED PlayAI in favour of Canopy Labs' Orpheus, so the
# old playai-tts default no longer resolves — set both of these if you use it:
# JARVIS_TTS_MODEL=canopylabs/orpheus-v1-english
# JARVIS_TTS_VOICE=autumn

# ---------------------------------------------------------------------------
# Reaching JARVIS from your phone or another machine.
#
# `npm run dev` listens on localhost ONLY. That is the security boundary:
# nothing off this machine can connect, so no password is needed locally.
#
# To reach it from elsewhere, put a tunnel in front — which gives you a real
# HTTPS URL, so voice works too:
#     cloudflared tunnel --url http://localhost:3000
#
# A tunnel rewrites the Host header, so JARVIS then REQUIRES this password.
# Without one set it refuses to serve rather than defaulting to open.
# ---------------------------------------------------------------------------
JARVIS_PASSWORD=

# ---------------------------------------------------------------------------
# Letting JARVIS use your computer. Off unless set to exactly "1".
#
# Enables list_files / read_file / write_file / run_command, confined to the
# workspace directory. Every write and every command needs your approval, and
# commands run with all API keys stripped from their environment.
#
# Think before combining this with a tunnel: anyone with the password can then
# run commands on this machine.
# ---------------------------------------------------------------------------
# JARVIS_ALLOW_COMPUTER=1
#
# With it on, the composer's "Work on this" button starts a task run: more tool
# rounds, and your instruction pinned so a long run can't forget it. The
# ceiling comes from the provider answering — 25 rounds on a flat-rate slot
# like NanoGPT, 5 on Groq, where a round is most of the per-minute budget.
# Writes can be approved for a whole run from the first card; commands always
# ask, every time.
# JARVIS_WORKSPACE=./workspace

# ---------------------------------------------------------------------------
# Your own model, on your own hardware.
#
# The free tiers are fast but metered. A local server is the opposite — slow,
# and it never runs out — which makes it the right backstop rather than the
# right default. JARVIS tries the cloud first and falls back to this when a
# rate limit hits, so you stop seeing hard failures.
#
# On the machine with the GPU or the fast CPU:
#     curl -fsSL https://ollama.com/install.sh | sh
#     ollama pull qwen3:4b          # ~2.5GB. See the README for sizing.
#     OLLAMA_HOST=0.0.0.0 OLLAMA_KEEP_ALIVE=-1 ollama serve
#
# OLLAMA_HOST=0.0.0.0 lets another machine (a Pi) reach it; KEEP_ALIVE=-1 stops
# the model being unloaded after five idle minutes, which otherwise costs
# 10-20 seconds on the first question after a gap.
#
# You can set the URL in Settings -> API keys -> Self-hosted instead, which
# has a Test button. Setting it here PINS it: the browser can no longer change
# it, which is what you want on a JARVIS reachable through a tunnel.
# ---------------------------------------------------------------------------
# JARVIS_LOCAL_BASE_URL=http://192.168.1.50:11434/v1

# Optional. A server on your own network needs no key; a rented host does.
# JARVIS_LOCAL_API_KEY=

# Pin the model, or JARVIS picks whichever sorts first alphabetically — a coin
# toss on a machine with several pulled.
# JARVIS_LOCAL_MODEL=qwen3:4b

# Must not exceed the num_ctx the model was loaded with, or Ollama silently
# truncates the conversation instead of erroring.
# JARVIS_LOCAL_CONTEXT=3500

# Let that machine sleep. With its MAC here, JARVIS sends a Wake-on-LAN packet
# when it finds it asleep — and answers from somewhere else meanwhile rather
# than making you wait. Needs WoL enabled in the BIOS *and* on the adapter
# (`sudo ethtool -s eth0 wol g`), and realistically a wired connection.
# JARVIS_LOCAL_MAC=

# Override if 255.255.255.255 is filtered on your subnet, e.g. 192.168.1.255
# JARVIS_LOCAL_BROADCAST=

# Which to use by default:
#   groq | gemini | cerebras | mistral | openrouter | nanogpt | featherless
#   | arli | awan | local
# Whichever has a key wins if this is unset. Set it to gemini for the most
# headroom, or groq for the lowest latency.
JARVIS_DEFAULT_PROVIDER=groq

# ---------------------------------------------------------------------------
# The room display.
#
# Open http://localhost:3000/display on the screen, or on the Pi:
#     chromium --kiosk http://localhost:3000/display
#
# For projector power over HDMI:
#     sudo apt install cec-utils
# ...and enable HDMI-CEC in the projector's OWN menu. It is off by default on
# most of them and is the usual reason power control looks broken. Vendors
# brand it differently: Anynet+, Bravia Sync, SimpLink, Viera Link.
#
# The display tools are offered only when a screen might exist — device mode,
# or a display currently connected — because their schemas cost 287 tokens on
# every request.
# ---------------------------------------------------------------------------

# Storage driver: fs (JSON files in ./data) | memory (ephemeral, for serverless)
# Leave unset to auto-detect: `fs` locally, `memory` on Vercel.
# JARVIS_STORAGE=fs
